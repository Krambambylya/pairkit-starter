{
  "name": "pairkit-starter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT-0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "prepare": "husky",
    "setup": "bash scripts/setup-env.sh",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backend": "bash scripts/dev-backend.sh",
    "build:web": "pnpm --filter web build",
    "build:backend": "pnpm --filter backend build",
    "build:core": "pnpm --filter @pairkit/core build",
    "test": "pnpm -r --if-present test:ci",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:changed": "bash scripts/verify-changed.sh",
    "boundaries": "depcruise --config .dependency-cruiser.cjs backend web mobile core-modules",
    "knip": "knip",
    "smoke:sync": "bash scripts/smoke-sync.sh"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
