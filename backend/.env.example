NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://pairkit:pairkit@localhost:5432/pairkit
DIRECT_URL=postgresql://pairkit:pairkit@localhost:5432/pairkit
SHADOW_DATABASE_URL=postgresql://pairkit:pairkit@localhost:5432/pairkit_shadow
# Required. At least 32 characters. `pnpm setup` fills this in backend/.env.dev.
# Do not put a real secret in this example file.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
WHITE_LIST_URLS=http://localhost:3000,http://localhost:8081
# Hop count when behind a reverse proxy (Render/nginx). Leave unset locally.
# TRUST_PROXY=1
# Optional OTLP collector. When unset, tracing is a no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# DATABASE_POOL_MAX=10
# Production Postgres: append ?sslmode=verify-full (require also verifies the cert).
