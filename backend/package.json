{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT-0",
  "main": "index.js",
  "scripts": {
    "prebuild": "pnpm --filter @pairkit/core build && prisma generate",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp src/config/public-jwt-secrets.txt dist/config/",
    "prebuild:debug": "pnpm --filter @pairkit/core build",
    "build:debug": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp src/config/public-jwt-secrets.txt dist/config/",
    "start": "node --enable-source-maps dist/server.js",
    "dev": "nodemon --ext ts --exec tsx --conditions=development src/server.ts",
    "debug": "pnpm run build:debug && node --enable-source-maps --inspect-brk dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run --coverage",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@pairkit/core": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "uni-response": "^2.0.6",
    "zod": "^4.4.3"
  }
}
